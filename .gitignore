# IDE 配置文件 (你刚才遇到的警告主要来自这里)
.idea/
.vscode/

# Python 编译缓存
__pycache__/
*.py[cod]
*$py.class

# 虚拟环境
venv/
env/
.venv/

# Flask 环境变量文件
.env
.flaskenv

# 数据库文件 (如果是本地 SQLite)
*.db
*.sqlite3

# 操作系统临时文件
.DS_Store
Thumbs.db

# --- 识别系统特定忽略项 ---

# 忽略运行时产生的输入图片和输出结果
# 这些是临时文件，不应该提交到代码仓库
inputs/*
outputs/*

# 如果你想保留文件夹结构但忽略内容，可以取消下面两行的注释，并手动在文件夹内创建名为 .gitkeep 的空文件
# !inputs/.gitkeep
# !outputs/.gitkeep

# 忽略大型模型权重文件
# .pt 文件通常很大，频繁提交会导致仓库体积迅速膨胀
*.pt
*.onnx

# 忽略 Ultralytics YOLO 自动生成的运行日志文件夹 (如果有训练或开启自动保存)
runs/

# 忽略日志文件
*.log